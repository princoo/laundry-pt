generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String              @id @default(cuid())
  email             String              @unique
  name              String?
  password          String
  role              Role                @default(HOUSEKEEPER)
  isActive          Boolean             @default(true)
  isAvailable       Boolean             @default(true)
  mustChangePassword  Boolean           @default(true)
  passwordResetToken  String?           @unique
  passwordResetExpiry DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  assignedRequests  Request[]           @relation("AssignedRequests")
  unassignedRequests Request[]          @relation("UnassignedRequests")
  authoredNotes     RequestNote[]       @relation("NoteAuthor")
  @@map("users")
}

enum Role {
  ADMIN
  SUPERVISOR
  HOUSEKEEPER
}

model LaundryItem {
  id            String  @id @default(cuid())
  nameEn        String
  nameFr        String
  priceNormal   Int?
  priceDryClean Int?
  pricePressing Int?
  isActive      Boolean @default(true)
  sortOrder     Int     @default(0)
  requestItems  RequestItem[]
  @@map("laundry_items")
}

model Request {
  id                String              @id @default(cuid())
  seq               Int                 @default(autoincrement())
  roomNumber        String
  guestName         String?
  isExpress         Boolean             @default(false)
  isHanger          Boolean             @default(false)
  note              String?
  status            RequestStatus       @default(PENDING)
  grossAmount       Int
  vatAmount         Int
  totalAmount       Int
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  collectedAt       DateTime?
  completedAt       DateTime?
  returnedAt        DateTime?
  assignedToId      String?
  assignedAt        DateTime?
  assignmentMethod  AssignmentMethod?
  unassignedFromId  String?
  unassignedAt      DateTime?
  assignedTo        User?               @relation("AssignedRequests", fields: [assignedToId], references: [id])
  unassignedFrom    User?               @relation("UnassignedRequests", fields: [unassignedFromId], references: [id])
  items             RequestItem[]
  notes             RequestNote[]
  alertEvents       RequestAlertEvent[]
  @@map("requests")
}

enum AssignmentMethod {
  AUTO
  MANUAL
}

enum ServiceType {
  NORMAL
  DRY_CLEAN
  PRESSING
}

enum RequestStatus {
  PENDING
  COLLECTED
  IN_PROGRESS
  READY
  DELIVERED
  CANCELLED
}

model RequestItem {
  id            String      @id @default(cuid())
  requestId     String
  laundryItemId String
  serviceType   ServiceType @default(NORMAL)
  quantity      Int
  unitPrice     Int
  subtotal      Int
  request       Request     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  laundryItem   LaundryItem @relation(fields: [laundryItemId], references: [id])
  @@map("request_items")
}

model RequestNote {
  id        String   @id @default(cuid())
  requestId String
  authorId  String?  // null for notes written before authorship, and for system/guest notes
  content   String
  createdAt DateTime @default(now())

  request   Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author    User?    @relation("NoteAuthor", fields: [authorId], references: [id])

  @@map("request_notes")
}

// Frozen record of an SLA breach the moment it's first detected — kept even
// after the request is delivered, so a rushed fix can't erase that it happened.
model RequestAlertEvent {
  id         String          @id @default(cuid())
  requestId  String
  level      AlertEventLevel
  detectedAt DateTime        @default(now())

  request    Request         @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, level])
  @@map("request_alert_events")
}

enum AlertEventLevel {
  PICKUP_OVERDUE
  RETURN_OVERDUE
  AT_RISK
  DEADLINE_MISSED
}
